# Copy to .env to override any of these. Every value below is already the
# built-in default -- this file only exists to show what's configurable.

# --- backend (fake Controller) ---
BACKEND_PORT=9001

# --- mcp_service ---
MCP_PORT=9005
BACKEND_HOST=http://localhost:9001
WORKER_API_KEY=demo-worker-key
PREPROCESSOR_API_KEY=demo-preprocessor-key
AGENT_MAX_TURNS=10

# Any OpenAI-compatible chat-completions server: Ollama, LM Studio, llama.cpp
# server, or OpenAI itself. If this isn't reachable when mcp_service starts,
# it automatically falls back to a small built-in offline demo brain -- see
# README.md. To use a real local model:
#   ollama serve
#   ollama pull qwen2.5:7b
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama

# --- cli.py ---
DEMO_PROJECT_ID=demo-project
DEMO_SIM_ID=demo-sim
DEMO_USER_ID=demo-user
